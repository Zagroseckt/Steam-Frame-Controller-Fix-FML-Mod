<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>SteamFrameControls</AssemblyName>
    <RootNamespace>SteamFrameControls</RootNamespace>
    <ResonitePath Condition="'$(ResonitePath)'=='' and Exists('$(HOME)/.local/share/Steam/steamapps/common/Resonite/FrooxEngine.dll')">$(HOME)/.local/share/Steam/steamapps/common/Resonite/</ResonitePath>
    <ResonitePath Condition="'$(ResonitePath)'=='' and Exists('$(HOME)/.steam/steam/steamapps/common/Resonite/FrooxEngine.dll')">$(HOME)/.steam/steam/steamapps/common/Resonite/</ResonitePath>
    <ResonitePath Condition="'$(ResonitePath)'=='' and '$(OS)' == 'Windows_NT' and Exists('$(ProgramFiles(x86))/Steam/steamapps/common/Resonite/FrooxEngine.dll')">$(ProgramFiles(x86))/Steam/steamapps/common/Resonite/</ResonitePath>
    <Deploy Condition="'$(Deploy)'==''">false</Deploy>
    <DeployPath Condition="'$(DeployPath)'=='' and Exists('$(HOME)/.local/share/Steam/steamapps/common/Resonite')">$(HOME)/.local/share/Steam/steamapps/common/Resonite/rml_mods</DeployPath>
    <DeployPath Condition="'$(DeployPath)'=='' and Exists('$(HOME)/.steam/steam/steamapps/common/Resonite')">$(HOME)/.steam/steam/steamapps/common/Resonite/rml_mods</DeployPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ResoniteModLoader" Version="5.0.1" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)FrooxEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)Elements.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Renderite.Shared">
      <HintPath>$(ResonitePath)Renderite.Shared.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(Deploy)'=='true'">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
